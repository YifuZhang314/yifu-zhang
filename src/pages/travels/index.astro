---
import BaseLayout from '../../layouts/BaseLayout.astro';

const description = 'Travel notes by Yifu Zhang.';
---

<BaseLayout title="Travels" description={description}>
  <header class="page-header section-shell">
    <h1>Travels</h1>
    <p class="page-deck">Notes from my travels.</p>
  </header>

  <section class="section-shell section-block" aria-labelledby="nice-heading">
    <p class="section-kicker">French Riviera, France</p>
    <h2 id="nice-heading">Nice</h2>
  </section>

  <section
    class="section-shell section-block"
    aria-labelledby="windermere-heading"
  >
    <p class="section-kicker">Lake District, England</p>
    <h2 id="windermere-heading">Windermere</h2>
  </section>
</BaseLayout>
