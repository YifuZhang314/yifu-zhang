---
import PublicationItem from '../components/PublicationItem.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import { education, profile, researchAreaLine } from '../data/profile';
import { publications } from '../data/publications';
import { featuredResearch } from '../data/research';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/site';

const description =
  'Yifu Zhang is an incoming Mathematics PhD student at Imperial College London, working in numerical analysis, randomized numerical linear algebra, approximation theory and operator learning.';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: 'https://yifuzhang314.github.io/yifu-zhang/',
  jobTitle: profile.currentPosition,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: profile.currentInstitution,
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: profile.previousDegree.institution,
  },
  knowsAbout: profile.researchAreas,
  sameAs: [profile.links.github],
};
---

<BaseLayout
  title={profile.name}
  description={description}
  jsonLd={personJsonLd}
>
  <section class="hero section-shell" aria-labelledby="home-title">
    <div class="hero-main">
      <p class="eyebrow">Mathematics · Imperial College London</p>
      <h1 id="home-title">{profile.name}</h1>
      <p class="hero-position">
        {profile.currentPosition} at {profile.currentInstitution}
      </p>
      <p class="hero-areas">{researchAreaLine}</p>
      <nav class="hero-links" aria-label="Profile links">
        <a href={sitePath('/research/')}>Research</a>
        <a href={sitePath('/publications/')}>Publications</a>
        <a href={sitePath(profile.links.cv)}
          >CV <span aria-hidden="true">↓</span></a
        >
        <a href={profile.links.github}
          >GitHub <span aria-hidden="true">↗</span></a
        >
      </nav>
    </div>
  </section>

  <section
    class="section-shell split-section"
    aria-labelledby="statement-title"
  >
    <div class="section-label">
      <h2 id="statement-title">Research interest</h2>
    </div>
    <div class="prose-large">
      <p>{profile.statement}</p>
      <p class="degree-note">
        Oxford {profile.previousDegree.degree} — {
          profile.previousDegree.result
        }.
      </p>
    </div>
  </section>

  <section
    class="section-shell split-section education-section"
    aria-labelledby="education-title"
  >
    <div class="section-label">
      <h2 id="education-title">Education</h2>
    </div>
    <ol class="education-timeline">
      {
        education.map((item, index) => (
          <li>
            <p class="education-period">{item.period}</p>
            <h3>{item.degree}</h3>
            <p class="education-institution">
              <a href={item.institutionUrl}>{item.institution}</a>
            </p>
            <p class="education-detail">
              {item.status}
              {index === 0 && (
                <>
                  {' · Supervised by '}
                  {profile.supervisors.map((supervisor, supervisorIndex) => (
                    <>
                      {supervisorIndex > 0 &&
                        (supervisorIndex === profile.supervisors.length - 1
                          ? ', and '
                          : ', ')}
                      <a href={supervisor.website}>{supervisor.name}</a>
                      {supervisor.institution !== item.institution &&
                        ` (${supervisor.institution})`}
                    </>
                  ))}
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-shell section-block" aria-labelledby="featured-title">
    <div class="section-heading-row">
      <div>
        <p class="section-kicker">Selected work</p>
        <h2 id="featured-title">Current research</h2>
      </div>
      <a class="section-link" href={sitePath('/research/')}
        >All research <span aria-hidden="true">→</span></a
      >
    </div>
    <div class="research-grid">
      {featuredResearch.map((project) => <ResearchPreview project={project} />)}
    </div>
  </section>

  <section
    class="section-shell section-block publication-section"
    aria-labelledby="publication-title"
  >
    <div class="section-heading-row">
      <div>
        <p class="section-kicker">Publication</p>
        <h2 id="publication-title">Recent preprint</h2>
      </div>
      <a class="section-link" href={sitePath('/publications/')}>
        Full citation <span aria-hidden="true">→</span>
      </a>
    </div>
    <PublicationItem publication={publications[0]} compact />
  </section>
</BaseLayout>
