---
import { profile } from '../../data/profile';
import { researchProjects } from '../../data/research';
import BaseLayout from '../../layouts/BaseLayout.astro';

const description =
  'Research by Yifu Zhang in numerical analysis, randomized numerical linear algebra, approximation theory, operator learning and earlier analytic number theory.';
---

<BaseLayout title="Research" description={description}>
  <header class="page-header section-shell">
    <h1>Research</h1>
    <p class="page-deck">
      Numerical analysis, randomized numerical linear algebra, approximation
      theory and operator learning.
    </p>
  </header>

  <section class="section-shell phd-note" aria-labelledby="phd-heading">
    <div>
      <p class="section-kicker">Current position</p>
      <h2 id="phd-heading">Incoming PhD</h2>
    </div>
    <div>
      <p>
        Incoming Mathematics PhD student at Imperial College London, supervised
        by {
          profile.supervisors.map((supervisor) => supervisor.name).join(', ')
        }.
      </p>
    </div>
  </section>

  <section
    class="section-shell research-list"
    aria-labelledby="projects-heading"
  >
    <div class="section-heading-row">
      <div>
        <h2 id="projects-heading">Projects</h2>
      </div>
    </div>

    {
      researchProjects.map((project) => (
        <article class="research-detail" id={project.slug}>
          <div class="research-detail-main">
            <p class="meta-line">{project.area}</p>
            <h3>{project.title}</h3>
            {project.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <p class="supervision">{project.supervision}</p>
            {project.links && (
              <nav
                class="text-links"
                aria-label={`Resources for ${project.title}`}
              >
                {project.links.map((link) => (
                  <a href={link.href}>
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </nav>
            )}
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>
