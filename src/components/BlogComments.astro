---
interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;
const fastCommentsConfig = {
  tenantId: 'w24Kw-j9Q85',
  urlId: pageId,
  url: pageUrl,
  pageTitle,
  disableUnverifiedLabel: true,
};
---

<section class="blog-comments" aria-labelledby="blog-comments-heading">
  <header class="blog-comments-header">
    <h2 id="blog-comments-heading">Comments</h2>
    <p>
      Comments are hosted by <a href="https://fastcomments.com/">FastComments</a
      >. No account or email address is required.
    </p>
  </header>

  <div class="blog-comments-widget">
    <div
      id="fastcomments-widget"
      data-fastcomments-config={JSON.stringify(fastCommentsConfig)}
    >
    </div>
    <noscript>JavaScript is required to view and post comments.</noscript>
  </div>
</section>

<script>
  const commentsContainer = document.querySelector('.blog-comments-widget');
  const commentsWidget = document.querySelector<HTMLElement>(
    '#fastcomments-widget',
  );

  const loadComments = () => {
    if (
      !commentsContainer ||
      !commentsWidget?.dataset.fastcommentsConfig ||
      commentsContainer.querySelector('script[data-fastcomments-loader]')
    )
      return;

    const fastCommentsWindow = window as Window & {
      fcConfigs?: Array<Record<string, string | boolean>>;
    };
    fastCommentsWindow.fcConfigs = [
      JSON.parse(commentsWidget.dataset.fastcommentsConfig),
    ];

    const commentsScript = document.createElement('script');
    commentsScript.src =
      'https://cdn.fastcomments.com/js/embed-v2-async.min.js';
    commentsScript.dataset.fastcommentsLoader = '';
    commentsScript.async = true;
    commentsContainer.prepend(commentsScript);
  };

  if ('IntersectionObserver' in window && commentsContainer) {
    const commentsObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        commentsObserver.disconnect();
        loadComments();
      },
      { rootMargin: '400px 0px' },
    );
    commentsObserver.observe(commentsContainer);
  } else {
    loadComments();
  }
</script>
