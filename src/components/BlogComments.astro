<section class="blog-comments" aria-labelledby="blog-comments-heading">
  <header class="blog-comments-header">
    <h2 id="blog-comments-heading">Comments</h2>
    <p>
      Comments are hosted on GitHub. Sign in with GitHub to join the discussion;
      no email address is requested by this site.
    </p>
  </header>

  <div class="blog-comments-widget">
    <noscript>
      JavaScript is required to view the comments here. You can still visit the
      <a href="https://github.com/YifuZhang314/yifu-zhang/issues"
        >blog discussions on GitHub</a
      >.
    </noscript>
  </div>
</section>

<script>
  const commentsContainer = document.querySelector('.blog-comments-widget');

  const loadComments = () => {
    if (!commentsContainer || commentsContainer.querySelector('script')) return;

    const commentsScript = document.createElement('script');
    commentsScript.src = 'https://utteranc.es/client.js';
    commentsScript.setAttribute('repo', 'YifuZhang314/yifu-zhang');
    commentsScript.setAttribute('issue-term', 'pathname');
    commentsScript.setAttribute('label', 'blog comments');
    commentsScript.setAttribute('theme', 'github-light');
    commentsScript.crossOrigin = 'anonymous';
    commentsScript.async = true;
    commentsContainer.prepend(commentsScript);
  };

  if ('IntersectionObserver' in window && commentsContainer) {
    const commentsObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        commentsObserver.disconnect();
        loadComments();
      },
      { rootMargin: '400px 0px' },
    );
    commentsObserver.observe(commentsContainer);
  } else {
    loadComments();
  }
</script>
